{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@maps/*": [
        "../maps/*"
      ],
      "expo-location": [
        "./node_modules/expo-location/build/index.d.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./node_modules/@react-native-async-storage/async-storage"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../maps/**/*.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
